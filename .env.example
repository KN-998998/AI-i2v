# ============================================================
# 环境变量模板（.env.example）— 可提交仓库，不含真实密钥
# 使用：复制为 .env 后填入真实密钥
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
# .env 已被 .gitignore 忽略，不会进仓库；密钥请只写在 .env
# ============================================================

# ── DeepSeek（Step 2 提示词生成 + Step 6 文案/配音）──
DEEPSEEK_API_KEY=sk-你的deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── 可灵 Kling（Step 3 图生视频）──
# 可灵开发者平台 API 密钥页的单个 API Key
KLING_API_KEY=你的kling_api_key
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-v2-6

# ── TTS（可选，不设则用 edge-tts 免费版）──
TTS_API_KEY=
TTS_VOICE=female_warm

# ── 素材库路径（可选，默认相对路径）──
IMAGE_LIBRARY=
BGM_FILE=
