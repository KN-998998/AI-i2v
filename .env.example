# ============================================================
# 环境变量模板（.env.example）— 可提交仓库，不含真实密钥
# 使用：复制为 .env 后填入真实密钥
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
# .env 已被 .gitignore 忽略，不会进仓库；密钥请只写在 .env
# ============================================================

# ── 可灵 Kling（画布：生成视频片段）──
# 可灵开发者平台 API 密钥页的单个 API Key
KLING_API_KEY=你的kling_api_key
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-3.0-omni

# Qwen TTS (optional; no voice is generated when unconfigured or set to none)
TTS_PROVIDER=qwen
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_MODELS=
QWEN_TTS_CLONE_MODEL=qwen3-tts-vc-2026-01-22
# 复刻音色格式：voice_id|显示名称|female/male/custom，多个音色使用英文逗号分隔
QWEN_TTS_CLONED_VOICES=
QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/audio/speech
QWEN_TTS_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation


# 腾讯云数据万象商品抠图（图片处理步骤）
# 仅写入 .env，绝不要提交真实 SecretId / SecretKey。
BACKGROUND_REMOVAL_PROVIDER=tencent
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENT_COS_BUCKET=kou-tu-1475104334
TENCENT_COS_MODEL=GoodsMatting
BACKGROUND_TEMPLATE_DIR=

# ── Web 开发服务 ──
APP_HOST=127.0.0.1
APP_PORT=8015
APP_RELOAD=true
