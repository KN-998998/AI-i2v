# ============================================================
# 环境变量模板（.env.example）— 可提交仓库，不含真实密钥
# 使用：复制为 .env 后填入真实密钥
#   Windows:  copy .env.example .env
#   macOS:    cp .env.example .env
# .env 已被 .gitignore 忽略，不会进仓库；密钥请只写在 .env
# ============================================================

# ── 可灵 Kling（画布：生成视频片段）──
# 可灵开发者平台 API 密钥页的单个 API Key
KLING_API_KEY=你的kling_api_key
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-3.0-omni

# Qwen TTS (optional; no voice is generated when unconfigured or set to none)
TTS_PROVIDER=qwen
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_MODELS=
QWEN_TTS_CLONE_MODEL=qwen3-tts-vc-2026-01-22
# 复刻音色格式：voice_id|显示名称|female/male/custom，多个音色使用英文逗号分隔
QWEN_TTS_CLONED_VOICES=
QWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/audio/speech
QWEN_TTS_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# Optional copy splitting assistant; the explicit AI button reuses QWEN_API_KEY.
QWEN_LLM_ENABLED=true
QWEN_LLM_MODEL=qwen3.7-flash
QWEN_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# 腾讯云数据万象商品抠图（图片处理步骤）
# 仅写入 .env，绝不要提交真实 SecretId / SecretKey。
BACKGROUND_REMOVAL_PROVIDER=tencent
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENT_COS_BUCKET=kou-tu-1475104334
TENCENT_COS_MODEL=GoodsMatting
BACKGROUND_TEMPLATE_DIR=

# 默认曲库：第 6 步没传自己的音乐时，成片从这里挑一首 BGM（留空 = 用仓库里的
# assets/bgm/default/）。音频文件不进 git，部署时把那个文件夹一起拷到服务器，
# 或者在这里指到服务器上放音乐的目录。
DEFAULT_BGM_DIR=

# ── Web 开发服务 ──
APP_HOST=127.0.0.1
APP_PORT=8015
APP_RELOAD=true

# ── 片尾信息卡 ──
# 店名 / 地址 / 定位，用 | 分隔，最多三行。填了之后每条成片自动带一张 1 秒的黑底卡。
# 11 条已发布的参考片全都有这么一张，工具原来一条都不加。
BRAND_END_CARD_LINES=

# 字幕字体。留空则按平台自动找（macOS 的 PingFang、Linux 的 Noto Sans CJK、Windows 的微软雅黑）。
# 机器上一个中文字体都没有时，ffmpeg 不会报错，中文会渲染成方框，预检会提前提醒。
CAPTION_FONT_FILE=

# ── 阿里云 OSS 素材抽取（ECS 部署）──
# 服务器使用 ECS RAM 角色获取临时凭证；这里不要填写 AK/SK。
OSS_BUCKET=
OSS_ENDPOINT=
# 必须按 Bucket 实际地域和对象前缀填写，不能根据 ECS 地域猜测。
OSS_ASSET_PREFIX=
OSS_REGION=
# 可选：ECS RAM 角色名；留空时从实例元数据服务自动发现，不是密钥。
OSS_RAM_ROLE_NAME=
# 可选：限制前端只显示这些分类；逗号分隔，留空则从 OSS 根目录读取分类。
OSS_ALLOWED_CATEGORIES=
# 任务临时目录及资源配额
JOB_TEMP_DIR=output/oss_jobs
OSS_MAX_CONCURRENT_JOBS=1
OSS_MAX_CATEGORIES=8
OSS_MAX_ASSETS_PER_CATEGORY=20
OSS_MAX_TOTAL_ASSETS=40
OSS_MAX_IMAGE_BYTES=52428800
OSS_MAX_REQUESTS_PER_MINUTE=30
OSS_JOB_RETENTION_HOURS=72
